{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teamruns",
  "version": "0.11.0",
  "identifier": "teamruns-client",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/teamruns-client/browser"
  },
  "app": {
    "windows": [
      {
        "title": "teamruns-client",
        "width": 1000,
        "height": 750,
        "center": true,
        "decorations": false,
        "fullscreen": false,
        "transparent": true,
        "visible": true,
        "focus": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "desktop-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
